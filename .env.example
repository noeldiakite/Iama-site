# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://iama:CHANGER_MOT_DE_PASSE@localhost:5432/iama
# Utilisé par docker-compose pour créer la base
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE

# --- Payload CMS ---
# Clé secrète longue et aléatoire : openssl rand -hex 32
PAYLOAD_SECRET=CHANGER_CLE_SECRETE

# Adresse publique du site, sans barre finale
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# preprod : site non indexé par les moteurs (robots.txt + balise noindex) ; prod : indexé
SITE_ENV=preprod

# --- E-mails (accusés de réception, notifications) ---
# Laisser SMTP_HOST vide en développement : les e-mails s'affichent dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@iama.aero
# Destinataire de secours si le champ du back-office est vide
EMAIL_NOTIFICATIONS=info@iama.aero

# --- Script de reprise des contenus (pnpm seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Phase 2 (paiement mobile money, hors marché actuel) ---
PAIEMENT_ACTIF=false
